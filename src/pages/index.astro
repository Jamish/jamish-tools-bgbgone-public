---
import '../styles/global.css';
import logoUrl from '../assets/logo.svg?url';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>bgbgone by jami.sh</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    .panel {
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
    }
    #drop-zone {
      border: 2px dashed rgba(0, 255, 102, 0.3);
      border-radius: 8px;
      padding: 64px 24px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      user-select: none;
      overflow: hidden;
    }
    :root[data-theme='light'] #drop-zone {
      border-color: rgba(0, 0, 0, 0.18);
    }
    #drop-zone:hover,
    #drop-zone.drag-over {
      border-color: var(--text);
      background: var(--accent);
    }
    #drop-zone.has-image {
      padding: 0;
      border-style: solid;
      border-color: rgba(0, 255, 102, 0.35);
    }
    :root[data-theme='light'] #drop-zone.has-image {
      border-color: rgba(0, 0, 0, 0.2);
    }
    #drop-zone.has-image:hover,
    #drop-zone.has-image.drag-over {
      border-color: var(--text);
      background: transparent;
    }
    #drop-zone.has-image:hover #drop-preview {
      opacity: 0.7;
    }
    #drop-preview {
      display: block;
      width: 100%;
      max-height: 360px;
      object-fit: contain;
      transition: opacity 0.15s;
      pointer-events: none;
    }
    #drop-label {
      margin: 0;
      font-size: 1rem;
    }
    #drop-label span {
      color: var(--muted);
      font-size: 0.85rem;
      display: block;
      margin-top: 6px;
    }
    #status {
      margin-top: 20px;
      color: var(--muted);
      font-size: 0.9rem;
    }
    #result {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-top: 28px;
    }
    #result[hidden] {
      display: none;
    }
    /* checkerboard to visualise transparency */
    #preview-wrap {
      width: 100%;
      border-radius: 6px;
      overflow: hidden;
      background-color: #c8c8c8;
      background-image:
        linear-gradient(45deg, #999 25%, transparent 25%),
        linear-gradient(-45deg, #999 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #999 75%),
        linear-gradient(-45deg, transparent 75%, #999 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    }
    #preview {
      display: block;
      width: 100%;
      height: auto;
    }
    #save-btn {
      background: transparent;
      border: 1px solid var(--text);
      color: var(--text);
      font-family: var(--mono);
      font-size: 0.9rem;
      padding: 8px 20px;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    #save-btn:hover {
      background: var(--text);
      color: var(--bg);
    }
    #info {
      width: 100%;
      padding-top: 20px;
      border-top: 1px solid rgba(0, 255, 102, 0.1);
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.7;
    }
    :root[data-theme='light'] #info {
      border-top-color: rgba(0, 0, 0, 0.08);
    }
    #info p {
      margin: 0 0 4px;
    }
    #info p:last-child {
      margin-bottom: 0;
    }
    #resize-options {
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    #resize-btns {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .resize-btn {
      background: transparent;
      border: 1px solid rgba(0, 255, 102, 0.25);
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.8rem;
      padding: 4px 12px;
      border-radius: 4px;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    :root[data-theme='light'] .resize-btn {
      border-color: rgba(0, 0, 0, 0.15);
    }
    .resize-btn:hover {
      border-color: var(--text);
      color: var(--text);
    }
    .resize-btn.active {
      border-color: var(--text);
      color: var(--text);
    }
    #resize-hint {
      margin: 0;
      font-size: 0.7rem;
      color: var(--muted);
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="site">
    <header class="site-header">
      <div class="header-row">
        <div class="brand">
          <a href="https://www.jami.sh"><img src={logoUrl} class="logo" alt="" /></a>
          bgbgone
          <small>Background Be Gone! by <a href="https://www.jami.sh">jami.sh</a></small>
        </div>
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">🌙</button>
      </div>
    </header>
    <main class="container">
      <div class="panel">
        <div id="drop-zone" role="button" tabindex="0" aria-label="Drop image here or click to choose a file">
          <input type="file" id="file-input" accept="image/*,.heic,.heif" hidden />
          <p id="drop-label">
            drop image here
            <span>or click to choose a file</span>
            <span>or paste from clipboard</span>
          </p>
          <img id="drop-preview" draggable="false" hidden alt="" />
        </div>
        <div id="resize-options">
          <p id="resize-hint">Downsize Image: helps avoid crashes on mobile</p>
          <div id="resize-btns" role="group" aria-label="Downscale options">
            <button class="resize-btn active" data-size="">no resize</button>
            <button class="resize-btn" data-size="2048">2048px</button>
            <button class="resize-btn" data-size="1024">1024px</button>
            <button class="resize-btn" data-size="512">512px</button>
          </div>
        </div>
        <p id="status" hidden></p>
        <div id="result" hidden>
          <div id="preview-wrap">
            <img id="preview" alt="background removed result" />
          </div>
          <button id="save-btn">↓ save .png</button>
        </div>
        <div id="info">
          <p>Your images are processed entirely in your browser — nothing is sent to any server. Processing time depends on your hardware.</p>
          <p>Built using <a href="https://github.com/imgly/background-removal-js">imgly/background-removal-js</a> (AGPL-3.0)</p>
          <p>This tool is <a href="https://github.com/Jamish/jamish-tools-bgbgone">open source on GitHub</a></p>
        </div>
      </div>
    </main>
  </div>

  <script>
    import '../scripts/theme-toggle.js';
    import BgWorker from '../scripts/bg-worker.js?worker';
    import { isHeic, heicTo } from 'heic-to';

    const dropZone = document.getElementById('drop-zone')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const dropLabel = document.getElementById('drop-label')!;
    const dropPreview = document.getElementById('drop-preview') as HTMLImageElement;
    const statusEl = document.getElementById('status')!;
    const resultEl = document.getElementById('result')!;
    const preview = document.getElementById('preview') as HTMLImageElement;
    const saveBtn = document.getElementById('save-btn')!;

    let currentObjectUrl: string | null = null;
    let inputFileName = 'image';
    let currentJobId = 0;
    let maxResizePx: number | null = null;

    document.querySelectorAll<HTMLButtonElement>('.resize-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.resize-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        maxResizePx = btn.dataset.size ? parseInt(btn.dataset.size) : null;
      });
    });

    const worker = new BgWorker();
    worker.onmessage = (e: MessageEvent) => {
      const { type, jobId, key, current, total, blob, message } = e.data;
      if (jobId !== currentJobId) return;
      if (type === 'progress' && total > 0) {
        showStatus(`${key} ${Math.round((current / total) * 100)}%`);
      } else if (type === 'result') {
        if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
        currentObjectUrl = URL.createObjectURL(blob as Blob);
        preview.src = currentObjectUrl;
        statusEl.hidden = true;
        resultEl.hidden = false;
        setTimeout(() => resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' }), 250);
      } else if (type === 'error') {
        showStatus('error: ' + message);
      }
    };

    function showStatus(msg: string) {
      statusEl.textContent = msg;
      statusEl.hidden = false;
    }

    function showDropPreview(blob: Blob) {
      const url = URL.createObjectURL(blob);
      dropPreview.onload = null;
      dropPreview.src = '';
      dropPreview.hidden = false;
      dropLabel.hidden = true;
      dropZone.classList.add('has-image');
      dropPreview.onload = () => URL.revokeObjectURL(url);
      dropPreview.src = url;
    }

    function processFile(blob: Blob) {
      preview.src = '';
      resultEl.hidden = true;
      showStatus('loading model…');
      currentJobId++;
      worker.postMessage({ jobId: currentJobId, file: blob });
    }

    async function resizeBlob(blob: Blob, maxPx: number): Promise<Blob> {
      const bitmap = await createImageBitmap(blob);
      const { width, height } = bitmap;
      if (width <= maxPx && height <= maxPx) {
        bitmap.close();
        return blob;
      }
      const scale = maxPx / Math.max(width, height);
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      return new Promise<Blob>((resolve, reject) =>
        canvas.toBlob(b => b ? resolve(b) : reject(new Error('canvas toBlob failed')), 'image/jpeg', 0.92)
      );
    }

    async function loadFile(file: File) {
      const baseName = file.name.replace(/\.[^.]+$/, '');
      inputFileName = baseName || 'pasted_image';

      let imageBlob: Blob = file;
      if (await isHeic(file)) {
        showStatus('converting HEIC…');
        imageBlob = await heicTo({ blob: file, type: 'image/jpeg', quality: 0.8 });
      }

      if (maxResizePx !== null) {
        showStatus('resizing…');
        imageBlob = await resizeBlob(imageBlob, maxResizePx);
      }

      showDropPreview(imageBlob);
      processFile(imageBlob);
    }

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) loadFile(file);
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
    dropZone.addEventListener('dragleave', (e) => {
      if (!dropZone.contains((e as DragEvent).relatedTarget as Node)) {
        dropZone.classList.remove('drag-over');
      }
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      const file = (e as DragEvent).dataTransfer?.files[0];
      if (file && (file.type.startsWith('image/') || /\.(heic|heif)$/i.test(file.name))) loadFile(file);
    });

    document.addEventListener('paste', (e) => {
      const items = Array.from((e as ClipboardEvent).clipboardData?.items ?? []);
      const imageItem = items.find(item => item.type.startsWith('image/'));
      if (!imageItem) return;
      const file = imageItem.getAsFile();
      if (file) loadFile(file);
    });

    saveBtn.addEventListener('click', () => {
      if (!currentObjectUrl) return;
      const a = document.createElement('a');
      a.href = currentObjectUrl;
      a.download = `${inputFileName}_bgbgone.png`;
      a.click();
    });
  </script>
</body>
</html>
